# Copy to .env and edit. .env is git-ignored; never commit real keys.

# Image loaded from the AI Hub EAP portal and tagged by scripts/load-image.sh (see README).
IRIS_IMAGE=irishealth-community:2027.1.0AI.109.0

# REPLAY (default, no model, no key) or LIVE (calls the real CareBridge.ExceptionInvestigator AI Hub agent).
CAREBRIDGE_AGENT_MODE=REPLAY

# --- LIVE option A (tested): local LM Studio server, free ---
# Load qwen/qwen3-4b-2507 in LM Studio and start its server on port 1234.
# CAREBRIDGE_AGENT_MODE=LIVE
# CAREBRIDGE_LLM_PROVIDER=openai
# CAREBRIDGE_LLM_BASE_URL=http://host.docker.internal:1234/v1
# CAREBRIDGE_LLM_MODEL=qwen/qwen3-4b-2507
# (Gemma 4 E4B in LM Studio failed when tools were sent: chat template error. Not recommended.)

# --- LIVE option B (untested in this project): a hosted AI Hub provider ---
# CAREBRIDGE_AGENT_MODE=LIVE
# CAREBRIDGE_LLM_PROVIDER=openai           # openai | anthropic | gemini | ...
# CAREBRIDGE_LLM_MODEL=<model id>
# OPENAI_API_KEY=<your key>                # or ANTHROPIC_API_KEY / GEMINI_API_KEY, or CAREBRIDGE_LLM_API_KEY

# Optional
# CAREBRIDGE_LLM_TIMEOUT=120               # seconds per model request
# CAREBRIDGE_LLM_MAX_TOKENS=700            # completion tokens per model call
# CAREBRIDGE_LLM_TEMPERATURE=0             # leave unset for providers that reject an explicit temperature
# CAREBRIDGE_LOCK_MODE=1                   # disable mode switching from the dashboard (public deployments)
