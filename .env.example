# Copy to .env and edit. .env is git-ignored; never commit real keys.

# Image you loaded from the AI Hub EAP portal and tagged (see README "Get the AI Hub image").
IRIS_IMAGE=irishealth-community:2027.1.0AI.109.0

# REPLAY (default, no key needed) or LIVE (calls the real CareBridge.ExceptionInvestigator AI Hub agent).
CAREBRIDGE_AGENT_MODE=REPLAY

# --- LIVE mode, option A: a hosted provider supported by AI Hub ---
# CAREBRIDGE_LLM_PROVIDER=openai          # openai | anthropic | gemini
# CAREBRIDGE_LLM_MODEL=gpt-4.1-mini
# OPENAI_API_KEY=sk-...                   # or ANTHROPIC_API_KEY / GEMINI_API_KEY, or CAREBRIDGE_LLM_API_KEY

# --- LIVE mode, option B: a local OpenAI-compatible server (no key, no cost) ---
# CAREBRIDGE_LLM_PROVIDER=openai
# CAREBRIDGE_LLM_BASE_URL=http://host.docker.internal:1234/v1   # LM Studio; Ollama: http://host.docker.internal:11434/v1
# CAREBRIDGE_LLM_MODEL=google/gemma-4-e4b

# Optional
# CAREBRIDGE_LLM_TIMEOUT=120              # seconds per model request
# CAREBRIDGE_LLM_TEMPERATURE=0            # omit for providers that reject an explicit temperature
# CAREBRIDGE_LOCK_MODE=1                  # disables mode switching from the dashboard (public demo)
